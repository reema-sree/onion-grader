# Application Environment Configuration
ENV=development
DATABASE_URL=sqlite:///./onion_grading.db
SECRET_KEY=change-this-super-secret-key-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# Feature Flags and External Services
MOCK_MODEL=false
SMS_MOCK=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
